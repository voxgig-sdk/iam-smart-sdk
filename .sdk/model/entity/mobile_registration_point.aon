# Entity: mobile_registration_point

main: kit: entity: mobile_registration_point: {

  alias: field: {}

  fields: [
    {
      name: "district"
      req: false
      short: "District where the mobile point operates"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      short: "Unique identifier for the mobile registration point"
      type: "`$STRING`"
    }
    {
      format: "double"
      name: "latitude"
      req: false
      short: "Latitude coordinate"
      type: "`$NUMBER`"
    }
    {
      name: "location"
      req: false
      short: "Location description of the mobile point"
      type: "`$STRING`"
    }
    {
      name: "locationEn"
      req: false
      short: "English location description"
      type: "`$STRING`"
    }
    {
      name: "locationZh"
      req: false
      short: "Chinese location description"
      type: "`$STRING`"
    }
    {
      format: "double"
      name: "longitude"
      req: false
      short: "Longitude coordinate"
      type: "`$NUMBER`"
    }
    {
      name: "name"
      req: false
      short: "Name of the mobile registration point location"
      type: "`$STRING`"
    }
    {
      name: "nameEn"
      req: false
      short: "English name of the mobile registration point"
      type: "`$STRING`"
    }
    {
      name: "nameZh"
      req: false
      short: "Chinese name of the mobile registration point"
      type: "`$STRING`"
    }
    {
      name: "region"
      req: false
      short: "Region (Hong Kong Island, Kowloon, New Territories)"
      type: "`$STRING`"
    }
    {
      name: "remarks"
      req: false
      short: "Additional remarks or notes"
      type: "`$STRING`"
    }
    {
      name: "schedule"
      req: false
      short: "Schedule of mobile registration point visits"
      type: "`$ARRAY`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "mobile_registration_point"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/open_data/iam_smart/mobile-registration-points"
          segments: [
            {
              lit: "open_data"
            }
            {
              lit: "iam_smart"
            }
            {
              lit: "mobile-registration-points"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
